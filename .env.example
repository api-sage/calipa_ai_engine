# Copy to .env (git-ignored) and fill in. Never commit real values.
CALIPA_DATABASE_URL=postgresql:///calipa
CALIPA_FCY_USERNAME=
CALIPA_FCY_PASSWORD=
# Model provider: "meta" (default) or "anthropic".
CALIPA_LLM_PROVIDER=meta
# Llama API model id, as listed by the Llama API for your account.
CALIPA_LLAMA_MODEL=
# USD per million tokens on your Llama API contract. Leave both empty if unknown:
# cost is then recorded as unknown and per-run call caps apply instead.
CALIPA_LLAMA_PRICE_INPUT_PER_MTOK=
CALIPA_LLAMA_PRICE_OUTPUT_PER_MTOK=
# Read by the SDKs directly.
LLAMA_API_KEY=
ANTHROPIC_API_KEY=

# API: "none" refuses every request until SSO is wired in; "dev_header" trusts an
# X-Calipa-User header (development only).
CALIPA_API_IDENTITY=none
# Origins allowed to call the API from a browser, as JSON.
CALIPA_API_CORS_ORIGINS=["http://localhost:3000"]

# Write-once store for audit-trail anchors. Unset: the worker warns and does not anchor.
CALIPA_ANCHOR_DIR=
# Exception groups analysed at once per run.
CALIPA_ANALYSIS_PARALLELISM=4
# Development only: let the worker apply migrations itself.
CALIPA_WORKER_AUTO_MIGRATE=false
